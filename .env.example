# Copy to .env.local, or use `vercel env pull .env.local --yes`.
# Never commit real values — .env.local is gitignored.

# Required for the contact form to deliver. Without it the form refuses to
# submit and tells the visitor to email directly.
RESEND_API_KEY=

# Optional. Where enquiries land. Defaults to the site email in lib/projects.ts.
CONTACT_TO=

# Optional. Sender address. Defaults to Resend's shared onboarding@resend.dev.
# Switch to an address on your own verified domain once you have one.
CONTACT_FROM=
